# OmniOS Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

# =============================================================================
# REQUIRED IN PRODUCTION (APP_ENV=production)
# When APP_ENV=production, the following variables MUST be set explicitly.
# The application will fail to start if any are missing or empty.
# =============================================================================
# DB_HOST=your_database_host
# DB_PORT=3306
# DB_USER=your_database_user
# DB_PASS=your_secure_database_password
# DB_NAME=omnios

# =============================================================================
# LOCAL DEVELOPMENT DEFAULTS (used when APP_ENV != production)
# These are safe XAMPP defaults and will be used if not overridden.
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=omnios

# =============================================================================
# APPLICATION ENVIRONMENT
# Set APP_ENV=production to enforce required configuration and production behavior.
# =============================================================================
APP_ENV=development
APP_DEBUG=true

# =============================================================================
# TRUSTED PROXY (for HTTPS detection behind reverse proxy)
# Set TRUSTED_PROXY=1 ONLY when deployed behind a reverse proxy (nginx, Apache, etc.)
# that is explicitly configured to:
#   1. Strip client-supplied X-Forwarded-Proto headers
#   2. Inject its own trusted X-Forwarded-Proto value
# Without this, X-Forwarded-Proto is ignored and HTTPS is detected from the
# direct server connection only.
# =============================================================================
# TRUSTED_PROXY=0

# =============================================================================
# CORS ALLOWED ORIGINS (comma-separated)
# Will be used by CORS module in Phase 2.
# =============================================================================
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com